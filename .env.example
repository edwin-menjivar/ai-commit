# Configuration for ai-commit. Copy this file to one of:
#
#   ./.env                          (per repository; gitignored here)
#   ~/.config/ai-commit/.env        (per user, for a globally installed CLI)
#
# Variables already exported in your shell always take precedence.

# Required. Get a key at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: model to use (default: gpt-4o-mini).
# Can also be set per-run with `ai-commit --model <model>`.
# OPENAI_MODEL=gpt-4o

# Optional: point at a local or self-hosted OpenAI-compatible server,
# e.g. Ollama (http://localhost:11434/v1) or LM Studio.
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: set to 1 to send diffs without stripping secrets first. Not recommended.
# AI_COMMIT_DISABLE_REDACTION=1

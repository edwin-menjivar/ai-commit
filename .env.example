# Copy to .env and fill in your key. The .env file is gitignored.
# Get a key at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: model to use (default: gpt-3.5-turbo).
# Can also be set per-run with `ai-commit --model <model>`.
# OPENAI_MODEL=gpt-4

# Optional: point at a local or self-hosted OpenAI-compatible server,
# e.g. Ollama (http://localhost:11434/v1) or LM Studio.
# OPENAI_API_BASE=https://api.openai.com/v1
